<view class="comment-list">
  <view class="empty" wx:if="{{list.length === 0}}">{{emptyText}}</view>

  <view
    class="comment-item"
    wx:for="{{list}}"
    wx:key="_id"
    data-id="{{item._id}}"
    data-own="{{item.openid === ownerOpenid ? 1 : 0}}"
    bindlongpress="onLongPress"
  >
    <view class="avatar">{{item.nicknameFirst || '匿'}}</view>

    <view class="body">
      <view class="row">
        <text class="nickname">{{item.nickname || '匿名用户'}}</text>
        <text class="muted">{{item.timeText}}</text>
      </view>

      <text class="content">{{item.content}}</text>

      <view class="actions">
        <text class="reply-btn" data-item="{{item}}" bindtap="onReply">回复</text>
        <view class="like-btn {{item.liked ? 'on' : ''}}" data-id="{{item._id}}" catchtap="onToggleLike">
          <text class="like-icon">{{item.liked ? '❤️' : '🤍'}}</text>
          <text class="like-num">{{item.likeCount || 0}}</text>
        </view>
        <text
          class="del-btn"
          wx:if="{{item.openid === ownerOpenid}}"
          data-id="{{item._id}}"
          bindtap="onDeleteTap"
        >删除</text>
        <text
          class="report-btn"
          wx:elif="{{ownerOpenid}}"
          data-id="{{item._id}}"
          bindtap="onReportTap"
        >举报</text>
      </view>

      <!-- 二级回复：只渲染一层，不递归，避免无限嵌套 -->
      <view class="children" wx:if="{{item.children.length > 0}}">
        <view
          class="child"
          wx:for="{{item.children}}"
          wx:for-item="child"
          wx:key="_id"
          data-id="{{child._id}}"
          data-own="{{child.openid === ownerOpenid ? 1 : 0}}"
          bindlongpress="onLongPress"
        >
          <text class="child-nick">{{child.nickname || '匿名用户'}}</text>
          <text class="child-content">{{child.content}}</text>
          <text class="muted child-time">{{child.timeText}}</text>
          <view class="like-btn small {{child.liked ? 'on' : ''}}" data-id="{{child._id}}" catchtap="onToggleLike">
            <text class="like-icon">{{child.liked ? '❤️' : '🤍'}}</text>
            <text class="like-num">{{child.likeCount || 0}}</text>
          </view>
        </view>
      </view>

      <view
        class="more-children"
        wx:if="{{item.childrenHasMore}}"
        data-id="{{item._id}}"
        data-loaded="{{item.children.length}}"
        catchtap="onLoadMoreChildren"
      >查看更多回复（共 {{item.replyCount}} 条）</view>
    </view>
  </view>
</view>
