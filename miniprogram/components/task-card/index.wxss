.task-card {
  margin-bottom: 20rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1d23;
  flex: 1;
  padding-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  display: block;
  font-size: 26rpx;
  color: #5a6069;
  margin-top: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.reward {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff5a1f;
}

.loc {
  font-size: 24rpx;
  color: #5a6069;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance {
  font-size: 24rpx;
  color: #9aa0a8;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.status-pending {
  background: #fff2ec;
  color: #ff5a1f;
}

.status-accepted {
  background: #eef4ff;
  color: #2f6bff;
}

.status-confirming {
  background: #fff8e6;
  color: #b37700;
}

.status-completed {
  background: #eefaf1;
  color: #1a9c4b;
}

.status-cancelled {
  background: #f2f3f5;
  color: #9aa0a8;
}
