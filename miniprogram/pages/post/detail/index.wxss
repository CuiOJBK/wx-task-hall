.post-page {
  padding-bottom: 200rpx;
}

/* 未登录引导 */
.login-guide {
  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.guide-desc {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.guide-btn {
  margin-top: 40rpx;
}

.post-nick {
  font-size: 26rpx;
  color: #5a6069;
  font-weight: 500;
}

.post-content {
  display: block;
  font-size: 32rpx;
  color: #1a1d23;
  line-height: 1.8;
  margin-top: 16rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.share-link {
  margin: 0 0 0 16rpx;
  padding: 4rpx 20rpx;
  font-size: 24rpx;
  color: #3c7fff;
  background: #eef4ff;
  border-radius: 999rpx;
  line-height: 1.7;
}

.share-link::after {
  border: none;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.img-thumb {
  width: 200rpx;
  height: 200rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #f5f6f8;
}

.report-link {
  margin-left: 24rpx;
  font-size: 26rpx;
  color: #8a8f99;
  padding: 6rpx 4rpx;
}

.post-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}

.like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f7f8fa;
}

.like-icon {
  font-size: 30rpx;
  line-height: 1;
}

.like-num {
  font-size: 26rpx;
  color: #9aa0a8;
}

.like-on .like-num {
  color: #ff5a1f;
}

.comment-head {
  margin-bottom: 8rpx;
}

.bottom-space {
  height: 40rpx;
}

/* 底部输入条与表情面板样式已抽到 components/comment-bar，本页不再维护 */
