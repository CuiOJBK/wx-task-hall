.doc {
  padding: 32rpx 28rpx 40rpx;
}

.block {
  margin-bottom: 36rpx;
}

.block:last-of-type {
  margin-bottom: 12rpx;
}

.block-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1d23;
  margin-bottom: 12rpx;
}

.para {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: #4a5058;
  margin-bottom: 12rpx;
}

.updated {
  display: block;
  font-size: 22rpx;
  margin-top: 24rpx;
  text-align: center;
}

.back-btn {
  margin: 32rpx 0 60rpx;
}
