.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #fff2ec;
  color: #ff5a1f;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1d23;
  display: block;
}

.nick-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #ff8f5f;
}

.menu-disabled {
  opacity: 0.5;
}

.openid {
  display: block;
  margin-top: 8rpx;
  word-break: break-all;
}

.menu {
  padding: 0 28rpx;
}

.login-btn {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

/* 资料不完整提示 */
.tip-card {
  background: #fff8e6;
  border: 1rpx solid #ffe9b8;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #b37700;
}

.tip-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #c99a3d;
}

.tip-btn {
  margin-top: 24rpx;
  height: 76rpx;
  font-size: 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  font-size: 28rpx;
  color: #1a1d23;
  border-bottom: 1rpx solid #eef0f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #c4c8ce;
  font-size: 32rpx;
}

.warn {
  background: #fff8e6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #b37700;
}

.footer {
  text-align: center;
  margin-top: 40rpx;
  font-size: 22rpx;
}
