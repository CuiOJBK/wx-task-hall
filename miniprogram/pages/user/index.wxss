.profile {
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #fff2ec;
  color: #ff5a1f;
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1d23;
  display: block;
}

.nick-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #ff8f5f;
}

.menu-disabled {
  opacity: 0.5;
}

.openid {
  display: block;
  margin-top: 8rpx;
  word-break: break-all;
}

.admin-entry {
  color: #ff5a1f;
  font-weight: 500;
}

.menu {
  padding: 0 28rpx;
}

.login-btn {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

/* 头像按钮（open-type=chooseAvatar） */
.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  border-radius: 50%;
  flex-shrink: 0;
  line-height: 1;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-hover {
  opacity: 0.8;
}

.avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: block;
}

/* 账号资料编辑卡 */
.edit-card {
  padding: 28rpx;
}

.edit-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1d23;
}

.edit-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
}

.nick-input {
  margin-top: 24rpx;
  height: 88rpx;
  padding: 0 28rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1d23;
}

.save-btn {
  margin-top: 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  font-size: 28rpx;
  color: #1a1d23;
  border-bottom: 1rpx solid #eef0f3;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #c4c8ce;
  font-size: 32rpx;
}

.warn {
  background: #fff8e6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #b37700;
}

.footer {
  text-align: center;
  margin-top: 40rpx;
  font-size: 22rpx;
}
