<view class="page">
  <view class="card profile">
    <!-- 头像：登录后用官方 chooseAvatar 按钮，未登录只展示占位 -->
    <button
      class="avatar-btn"
      wx:if="{{authorized}}"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      hover-class="avatar-hover"
    >
      <image wx:if="{{user.avatarUrl}}" class="avatar-img" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">{{avatarText}}</view>
    </button>
    <view wx:else class="avatar">{{avatarText}}</view>

    <view class="profile-info">
      <text class="nickname">{{authorized ? (user.nickname || '未设置昵称') : '未登录'}}</text>
      <text class="muted nick-hint" wx:if="{{authorized && profileComplete}}">
        {{canChangeNickname ? '昵称还可修改 1 次' : '昵称已修改过，不可再改'}}
      </text>
      <text class="muted openid" wx:if="{{authorized}}" bindtap="onCopyOpenid">openid: {{openid}}（点击复制）</text>
      <text class="muted openid" wx:else>登录后可发布任务、接单与评论</text>
    </view>
  </view>

  <button class="btn btn-primary login-btn" wx:if="{{!authorized}}" bindtap="onLoginTap">微信一键登录</button>

  <!-- 账号资料：昵称用官方 nickname 输入控件，头像点上方头像更换 -->
  <view class="card edit-card" wx:if="{{authorized}}">
    <text class="edit-title">{{profileComplete ? '修改昵称' : '设置昵称'}}</text>
    <text class="muted edit-desc">
      {{profileComplete ? (canChangeNickname ? '昵称只能修改一次，请谨慎填写' : '昵称已修改过，不可再改') : '首次设置昵称不占用修改次数'}}
    </text>

    <input
      class="nick-input"
      type="nickname"
      value="{{nickInput}}"
      disabled="{{!canChangeNickname}}"
      placeholder="点击填写昵称（2-20 字）"
      maxlength="20"
      bindinput="onNickInput"
    />

    <button
      class="btn btn-primary save-btn"
      disabled="{{!canChangeNickname}}"
      bindtap="onSaveNickname"
    >保存昵称</button>
  </view>

  <view class="warn" wx:if="{{loginError}}">登录失败：{{loginError}}　请检查云开发是否开通</view>

  <view class="card menu">
    <view class="menu-item" bindtap="onGoTasks">
      <text>我的任务</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onOpenAgreement">
      <text>用户协议与隐私政策</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text>关于</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="muted footer">
    v0.4.0 · 待实现：实名认证、信用分、消息通知
  </view>
</view>
