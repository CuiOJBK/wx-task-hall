.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.field:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #5a6069;
  display: block;
  margin-bottom: 12rpx;
}

.req {
  color: #ff5a1f;
  margin-left: 4rpx;
}

.input {
  height: 72rpx;
  font-size: 30rpx;
  color: #1a1d23;
}

.textarea {
  width: 100%;
  height: 180rpx;
  font-size: 28rpx;
  color: #1a1d23;
  line-height: 1.6;
}

.loc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.loc-text {
  font-size: 28rpx;
  color: #1a1d23;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-placeholder {
  color: #9aa0a8;
}

.loc-clear {
  font-size: 24rpx;
  color: #ff5a1f;
  margin-left: 16rpx;
}

.loc-tip {
  display: block;
  margin-top: 10rpx;
}

.submit {
  margin-top: 40rpx;
}

.tip {
  text-align: center;
  margin-top: 24rpx;
}
