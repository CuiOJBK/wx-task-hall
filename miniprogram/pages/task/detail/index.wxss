.foot-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 8rpx 24rpx;
}

.share-btn {
  margin: 0;
  padding: 8rpx 26rpx;
  font-size: 26rpx;
  color: #3c7fff;
  background: #eef4ff;
  border-radius: 999rpx;
  line-height: 1.6;
}

.share-btn::after {
  border: none;
}

.report-text {
  font-size: 26rpx;
  color: #8a8f99;
  padding: 10rpx 4rpx;
}

.detail-page {
  padding-bottom: 200rpx;
}

/* 未登录引导 */
.login-guide {
  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.guide-desc {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.guide-btn {
  margin-top: 40rpx;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  margin-left: 16rpx;
}

.status-pending {
  background: #fff2ec;
  color: #ff5a1f;
}

.status-accepted {
  background: #eef4ff;
  color: #2f6bff;
}

.status-confirming {
  background: #fff8e6;
  color: #b37700;
}

.status-completed {
  background: #eefaf1;
  color: #1a9c4b;
}

.status-cancelled {
  background: #f2f3f5;
  color: #9aa0a8;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.reward {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff5a1f;
}

.detail-desc {
  font-size: 28rpx;
  color: #3d434b;
  line-height: 1.75;
  white-space: pre-wrap;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #9aa0a8;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1a1d23;
  word-break: break-all;
}

.link {
  color: #2f6bff;
}

.action-card {
  padding: 24rpx;
}

.cancel-btn {
  margin-top: 16rpx;
}

.no-action {
  text-align: center;
  padding: 12rpx 0;
}

.comment-head {
  margin-bottom: 8rpx;
}

.bottom-space {
  height: 40rpx;
}

/* 底部输入条与表情面板样式已抽到 components/comment-bar，本页不再维护 */

.timeout-bar {
  background: #fff8e6;
  border: 1rpx solid #ffe9b8;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #8a6d1f;
}

.contact-value {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.contact-toggle {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff5a1f;
  padding: 6rpx 0 6rpx 12rpx;
}

/* 图片：任务配图与完成凭证共用 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.img-thumb {
  width: 200rpx;
  height: 200rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 12rpx;
  background: #f5f6f8;
}

.proof {
  margin-top: 20rpx;
}

.proof-grid {
  margin-top: 10rpx;
}
