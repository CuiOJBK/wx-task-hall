  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.guide-desc {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.guide-btn {
  margin-top: 40rpx;
}
