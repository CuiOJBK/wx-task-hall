.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #5a6069;
  padding: 16rpx 0;
  border-radius: 12rpx;
}

.tab-active {
  background: #fff2ec;
  color: #ff5a1f;
  font-weight: 600;
}

/* 未登录引导 */
