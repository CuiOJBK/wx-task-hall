.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #5a6069;
  padding: 16rpx 0;
  border-radius: 12rpx;
}

.tab-active {
  background: #fff2ec;
  color: #ff5a1f;
  font-weight: 600;
}

/* 未登录引导 */
.login-guide {
  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  text-align: center;
}

.guide-desc {
  display: block;
  margin-top: 16rpx;
  line-height: 1.7;
}

.guide-btn {
  margin-top: 40rpx;
}

/* 状态筛选：次要层级，比角色 Tab 轻 */
.filters {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
  width: 100%;
}

.filter {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 24rpx;
  color: #8a8f99;
  flex-shrink: 0;
}

.filter.on {
  background: #fff2ec;
  color: #ff5a1f;
  font-weight: 500;
}
